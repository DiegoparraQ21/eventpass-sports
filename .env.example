# Solo para desarrollo local: dominio de ngrok sin /webhook al final.
VITE_N8N_PROXY_TARGET=https://tu-instancia-n8n.example
VITE_N8N_WEBHOOK_BASE_URL=/n8n/webhook

# Ruta local que Vite reenviará a la URL Production POST de WF10.
VITE_N8N_CHAT_URL=/n8n/webhook/REEMPLAZAR_CHAT_TRIGGER

# Solo en Vercel: crea esta variable en Settings → Environment Variables.
# No lleva VITE_ porque debe permanecer del lado del servidor.
N8N_PUBLIC_URL=https://tu-instancia-n8n.example
