    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst req=$('Validar solicitud CRUD').first().json;\nconst users=$input.all().map(i=>i.json).filter(u=>u.usuario_id);\nconst now=new Date().toISOString();\nconst publicUser=u=>({usuario_id:u.usuario_id,nombre:u.nombre,email:u.email_normalizado,estado:u.estado,fecha_registro:u.fecha_registro,fecha_actualizacion:u.fecha_actualizacion});\nconst fail=(status,code,message)=>({write:false,status,response:{ok:false,data:null,error:{code,message}},audit:null});\nconst audit=(record,action,detail)=>({auditoria_id:'AUD-'+crypto.randomUUID(),usuario_id:record.usuario_id,accion:action,fecha:now,resultado:'OK',detalle:detail});\nconst current=users.find(u=>u.usuario_id===req.data.usuario_id||String(u.email_normalizado||'').toLowerCase()===String(req.data.email||'').trim().toLowerCase());\nlet result;\ntry {\n  if(req.operation==='CREATE') {\n    if(users.some(u=>String(u.email_normalizado||'').toLowerCase()===req.data.email)) result=fail(409,'EMAIL_DUPLICADO','Ya existe un usuario con ese email.');\n    else {\n      const salt=crypto.randomBytes(16).toString('hex');\n      const record={usuario_id:'USR-'+crypto.randomUUID(),nombre:req.data.nombre,email_normalizado:req.data.email,password_hash:crypto.pbkdf2Sync(req.data.password,salt,120000,32,'sha256').toString('hex'),password_salt:salt,estado:'ACTIVO',fecha_registro:now,fecha_actualizacion:now};\n      result={write:true,status:201,record,response:{ok:true,data:publicUser(record),error:null},audit:audit(record,'CREATE','Usuario creado mediante WF01.')};\n    }\n  } else if(!current) result=fail(404,'USUARIO_NO_ENCONTRADO','No se encontró el usuario.');\n  else if(req.operation==='READ') result={write:false,status:200,response:{ok:true,data:publicUser(current),error:null},audit:null};\n  else if(req.operation==='DEACTIVATE') {\n    const record={...current,estado:'INACTIVO',fecha_actualizacion:now};\n    result={write:true,status:200,record,response:{ok:true,data:publicUser(record),error:null},audit:audit(record,'DEACTIVATE','Cuenta desactivada lógicamente.')};\n  } else {\n    const email=req.data.email===undefined?current.email_normalizado:String(req.data.email).trim().toLowerCase();\n    const nombre=req.data.nombre===undefined?current.nombre:String(req.data.nombre).trim();\n    if(!nombre||nombre.length>120||!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) result=fail(400,'DATOS_INVALIDOS','Revisa nombre y email.');\n    else if(users.some(u=>u.usuario_id!==current.usuario_id&&String(u.email_normalizado||'').toLowerCase()===email)) result=fail(409,'EMAIL_DUPLICADO','El email ya pertenece a otra cuenta.');\n    else {\n      const record={...current,nombre,email_normalizado:email,fecha_actualizacion:now};\n      if(req.data.password!==undefined) { const pass=String(req.data.password); if(pass.length<8||pass.length>200) return [{json:fail(400,'PASSWORD_INVALIDA','La contraseña debe tener entre 8 y 200 caracteres.')}]; const salt=crypto.randomBytes(16).toString('hex'); record.password_salt=salt; record.password_hash=crypto.pbkdf2Sync(pass,salt,120000,32,'sha256').toString('hex'); }\n      result={write:true,status:200,record,response:{ok:true,data:publicUser(record),error:null},audit:audit(record,'UPDATE','Perfil actualizado mediante WF01.')};\n    }\n  }\n} catch(error) { result=fail(500,'ERROR_INTERNO','No fue posible procesar la cuenta.'); }\nreturn [{json:result.write?{...result.record,...result}:result}];"
      },
