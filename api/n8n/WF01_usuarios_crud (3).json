      "parameters": {
        "jsCode": "const body=$json.body||{};\nconst operation=String(body.operation||'').trim().toUpperCase();\nconst data=body.data||{};\nconst fail=(status,code,message)=>({valid:false,status,response:{ok:false,data:null,error:{code,message}}});\nif(!['CREATE','READ','UPDATE','DEACTIVATE'].includes(operation)) return [{json:fail(400,'OPERACION_INVALIDA','Usa CREATE, READ, UPDATE o DEACTIVATE.')}];\nif(operation==='CREATE'){\n const nombre=String(data.nombre||'').trim(), email=String(data.email||'').trim().toLowerCase(), password=String(data.password||'');\n if(nombre.length<2||nombre.length>120||!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)||password.length<8||password.length>200) return [{json:fail(400,'DATOS_INVALIDOS','Revisa nombre, email y contraseña.')}];\n data.nombre=nombre; data.email=email; data.password=password;\n}\nif(['READ','UPDATE','DEACTIVATE'].includes(operation)&&!String(data.usuario_id||data.email||'').trim()) return [{json:fail(400,'IDENTIFICADOR_REQUERIDO','Envía usuario_id o email.')}];\nreturn [{json:{valid:true,operation,data,status:200,response:null}}];"
      },
