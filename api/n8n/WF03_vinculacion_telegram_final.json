    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst req=$('Entrada Webhook').first().json;\nconst body=req.body||{};\nconst token=String(req.headers?.authorization||'').replace(/^Bearer\\s+/i,'');\nconst users=$('Leer usuarios web').all().map(i=>i.json).filter(r=>r.usuario_id);\nconst sessions=$('Leer sesiones web').all().map(i=>i.json).filter(r=>r.session_id);\nconst now=new Date();\nconst fail=(status,code,message)=>({write:false,status,result:{ok:false,error:{code,message}}});\nif(body.operacion!=='GENERAR_CODIGO') return [{json:fail(400,'OPERACION_INVALIDA','Usa la operación GENERAR_CODIGO')}];\nconst session=sessions.find(s=>s.session_token===token&&s.estado==='ACTIVA');\nif(!session||!Number.isFinite(Date.parse(session.expira_en))||Date.parse(session.expira_en)<=+now) return [{json:fail(401,'SESION_INVALIDA','Inicia sesión nuevamente')}];\nconst user=users.find(u=>u.usuario_id===session.usuario_id&&u.estado==='ACTIVO');\nif(!user) return [{json:fail(401,'USUARIO_INACTIVO','Cuenta inactiva')}];\nconst row={codigo_id:crypto.randomUUID(),usuario_id:user.usuario_id,codigo:crypto.randomBytes(8).toString('hex').toUpperCase(),creado_en:now.toISOString(),expira_en:new Date(+now+10*60*1000).toISOString(),estado:'PENDIENTE',usado_en:''};\nreturn [{json:{write:true,status:200,row,result:{ok:true,data:{codigo:row.codigo,expira_en:row.expira_en}}}}];"
      },
