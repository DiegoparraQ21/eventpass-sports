    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst input=$('Validar comando Telegram').first().json;\nconst codes=$('Leer codigos Telegram').all().map(i=>i.json).filter(r=>r.codigo_id);\nconst users=$('Leer usuarios Telegram').all().map(i=>i.json).filter(r=>r.usuario_id);\nconst links=$('Leer vinculaciones Telegram').all().map(i=>i.json).filter(r=>r.vinculacion_id);\nconst now=new Date();\nconst fail=reply=>({ok:false,reply,codeRow:null,linkRow:null});\nlet code=codes.find(c=>String(c.codigo||'').toUpperCase()===input.codigo);\nif(!code||code.estado!=='PENDIENTE') return [{json:fail('Código usado o inválido. Solicita uno nuevo desde EventPass Sports.')}];\nif(!Number.isFinite(Date.parse(code.expira_en))||Date.parse(code.expira_en)<=+now) return [{json:fail('El código venció. Solicita uno nuevo desde EventPass Sports.')}];\nconst user=users.find(u=>u.usuario_id===code.usuario_id&&u.estado==='ACTIVO');\nif(!user) return [{json:fail('La cuenta asociada no está activa.')}];\nconst occupied=links.find(l=>String(l.chat_id)===input.chat_id&&l.estado==='ACTIVA'&&l.usuario_id!==user.usuario_id);\nif(occupied) return [{json:fail('Este chat de Telegram ya está vinculado a otra cuenta.')}];\nconst previous=links.find(l=>l.usuario_id===user.usuario_id&&l.estado==='ACTIVA');\nconst codeRow={...code,estado:'USADO',usado_en:now.toISOString()};\nconst linkRow={vinculacion_id:previous?.vinculacion_id||crypto.randomUUID(),usuario_id:user.usuario_id,chat_id:input.chat_id,telegram_username:input.telegram_username,fecha_vinculacion:now.toISOString(),estado:'ACTIVA'};\nreturn [{json:{ok:true,reply:'¡Cuenta vinculada correctamente a EventPass Sports!',codeRow,linkRow}}];"
      },
