    {
      "parameters": {
        "jsCode": "const crypto=require('crypto'); const req=$('Normalizar formulario de eventos').first().json; const events=$input.all().map(i=>i.json).filter(e=>e.evento_id); const now=new Date().toISOString(); const fail=message=>({write:false,message,formSubmittedText:message}); if(!req.valid) return [{json:fail(req.message)}]; const find=()=>events.find(e=>e.evento_id===String(req.data.evento_id||'').trim()); const required=d=>['nombre','categoria','descripcion','fecha','hora','lugar','capacidad'].every(k=>String(d[k]??'').trim()!==''); let out; if(req.operation==='READ'){const rows=req.data.evento_id?[find()].filter(Boolean):events;out={write:false,message:rows.length+' evento(s) consultado(s).',formSubmittedText:rows.length+' evento(s) consultado(s).',result:rows};} else if(req.operation==='CREATE'){if(!required(req.data)||!Number.isFinite(Number(req.data.capacidad))||Number(req.data.capacidad)<0) out=fail('Completa los campos obligatorios y una capacidad válida.'); else {const record={evento_id:'EVT-'+crypto.randomUUID().slice(0,8).toUpperCase(),nombre:String(req.data.nombre).trim(),categoria:String(req.data.categoria).trim(),descripcion:String(req.data.descripcion).trim(),fecha:String(req.data.fecha),hora:String(req.data.hora),lugar:String(req.data.lugar).trim(),capacidad:Number(req.data.capacidad),imagen_url:String(req.data.imagen_url||'').trim(),organizador:String(req.data.organizador||'EventPass Sports').trim(),estado:['BORRADOR','PUBLICADO'].includes(String(req.data.estado))?req.data.estado:'BORRADOR',fecha_creacion:now,fecha_actualizacion:now};out={write:true,...record,message:'Evento creado: '+record.evento_id,formSubmittedText:'Evento creado correctamente.',audit:{auditoria_id:'AUD-'+crypto.randomUUID(),evento_id:record.evento_id,accion:'CREATE',fecha:now,resultado:'OK',detalle:'Evento creado desde n8n Form Trigger.'}};}} else {const current=find();if(!current) out=fail('No existe el evento indicado.');else {let record={...current}; if(req.operation==='CANCEL')record.estado='CANCELADO';else if(req.operation==='CLOSE')record.estado='CERRADO';else {for(const k of ['nombre','categoria','descripcion','fecha','hora','lugar','imagen_url','organizador','estado']) if(String(req.data[k]??'').trim()!=='')record[k]=String(req.data[k]).trim();if(String(req.data.capacidad??'').trim()!==''){if(!Number.isFinite(Number(req.data.capacidad))||Number(req.data.capacidad)<0)return[{json:fail('Capacidad inválida.')}];record.capacidad=Number(req.data.capacidad);}}record.fecha_actualizacion=now;out={write:true,...record,message:'Evento actualizado.',formSubmittedText:'Operación completada.',audit:{auditoria_id:'AUD-'+crypto.randomUUID(),evento_id:record.evento_id,accion:req.operation,fecha:now,resultado:'OK',detalle:'Cambio de estado o actualización desde administración.'}};}} return [{json:out}];"
      },
