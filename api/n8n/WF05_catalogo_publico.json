    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst req = $('Webhook catálogo público').first().json;\nconst q = req.query || {};\nconst eventId = String(q.evento_id || '').trim();\nconst category = String(q.categoria || '').trim().toLowerCase();\nconst now = Date.now();\n\nconst events = $('Leer Eventos').all().map(item => item.json).filter(event => event.evento_id);\nconst enrollments = $input.all().map(item => item.json).filter(row => row.inscripcion_id);\nconst starts = event => Date.parse(`${String(event.fecha || '')}T${String(event.hora || '00:00')}-05:00`);\nconst normalizeState = value => String(value || '').trim().toUpperCase();\n\n// Se muestran los eventos que pueden ser vistos públicamente.\n// Un BORRADOR queda oculto; CERRADO y CANCELADO se ven, pero no se pueden inscribir.\nconst publicStates = new Set(['PUBLICADO', 'CERRADO', 'CANCELADO']);\nconst visible = events.filter(event => publicStates.has(normalizeState(event.estado)));\nconst filtered = visible.filter(event =>\n  (!eventId || event.evento_id === eventId) &&\n  (!category || String(event.categoria || '').toLowerCase() === category)\n);\n\nconst items = filtered.map(event => {\n  const confirmed = enrollments.filter(row => row.evento_id === event.evento_id && row.estado === 'CONFIRMADA').length;\n  const capacity = Number(event.capacidad) || 0;\n  const remaining = Math.max(0, capacity - confirmed);\n  const future = Number.isFinite(starts(event)) && starts(event) > now;\n  const storedState = normalizeState(event.estado);\n  const visibleState = storedState === 'PUBLICADO' && !future ? 'CERRADO' : storedState;\n\n  return {\n    ...event,\n    estado: visibleState,\n    capacidad: capacity,\n    inscripciones_confirmadas: confirmed,\n    cupos_disponibles: remaining,\n    disponible: visibleState === 'PUBLICADO' && future && remaining > 0,\n  };\n});\n\nconst type = eventId ? 'DETALLE' : category ? 'FILTRO' : 'LISTADO';\nconst status = eventId && items.length === 0 ? 404 : 200;\nconst response = eventId && items.length === 0\n  ? { ok: false, data: null, error: { code: 'EVENTO_NO_VISIBLE', message: 'No hay un evento visible con ese ID.' } }\n  : { ok: true, data: { eventos: items }, error: null };\n\nreturn [{\n  json: {\n    consulta_id: `CAT-${crypto.randomUUID()}`,\n    fecha: new Date().toISOString(),\n    tipo: type,\n    evento_id: eventId,\n    categoria: category,\n    resultado_count: items.length,\n    visitor_id: String(q.visitor_id || ''),\n    status_http: status,\n    status,\n    response,\n  },\n}];"
      },
