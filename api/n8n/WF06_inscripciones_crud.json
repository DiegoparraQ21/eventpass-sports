    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst req=$('Webhook inscripciones').first().json; const body=req.body||{}; const op=String(body.operacion||'').toUpperCase(); const token=String(req.headers?.authorization||'').replace(/^Bearer\\s+/i,''); const now=new Date();\nconst sessions=$('Leer Sesiones').all().map(i=>i.json).filter(r=>r.session_id); const users=$('Leer Usuarios').all().map(i=>i.json).filter(r=>r.usuario_id); const links=$('Leer Vinculaciones').all().map(i=>i.json).filter(r=>r.vinculacion_id); const events=$('Leer Eventos').all().map(i=>i.json).filter(r=>r.evento_id); const rows=$input.all().map(i=>i.json).filter(r=>r.inscripcion_id);\nconst fail=(status,code,message)=>({write:false,notify:false,status,response:{ok:false,data:null,error:{code,message}}});\nconst session=sessions.find(s=>s.session_token===token&&s.estado==='ACTIVA'&&Date.parse(s.expira_en)>+now); const user=session&&users.find(u=>u.usuario_id===session.usuario_id&&u.estado==='ACTIVO'); if(!session||!user)return[{json:fail(401,'SESION_INVALIDA','Inicia sesión nuevamente.')}];\nconst starts=e=>Date.parse(String(e.fecha||'')+'T'+String(e.hora||'00:00')+'-05:00'); const publicRow=r=>({inscripcion_id:r.inscripcion_id,evento_id:r.evento_id,estado:r.estado,fecha_inscripcion:r.fecha_inscripcion,nombre_acreditacion:r.nombre_acreditacion,observaciones:r.observaciones,orden_espera:r.orden_espera}); let out;\nif(op==='READ'){out={write:false,notify:false,status:200,response:{ok:true,data:{inscripciones:rows.filter(r=>r.usuario_id===user.usuario_id).map(publicRow)},error:null}};}\nelse if(!['CREATE','UPDATE','CANCEL'].includes(op))out=fail(400,'OPERACION_INVALIDA','Usa CREATE, READ, UPDATE o CANCEL.');\nelse if(op==='CREATE'){\n if(!links.some(l=>l.usuario_id===user.usuario_id&&l.estado==='ACTIVA'))out=fail(409,'TELEGRAM_REQUERIDO','Vincula Telegram antes de inscribirte.');\n else {const event=events.find(e=>e.evento_id===String(body.evento_id||'')); if(!event)out=fail(404,'EVENTO_NO_EXISTE','No existe el evento.'); else if(event.estado!=='PUBLICADO'||!Number.isFinite(starts(event))||starts(event)<=+now)out=fail(409,'EVENTO_NO_DISPONIBLE','El evento no admite inscripciones.'); else {const active=rows.find(r=>r.usuario_id===user.usuario_id&&r.evento_id===event.evento_id&&['CONFIRMADA','LISTA_ESPERA'].includes(r.estado)); if(active)out={write:false,notify:false,status:200,response:{ok:true,data:{inscripcion:publicRow(active),idempotente:true},error:null}}; else {const confirmed=rows.filter(r=>r.evento_id===event.evento_id&&r.estado==='CONFIRMADA').length;const state=confirmed<Number(event.capacidad)?'CONFIRMADA':'LISTA_ESPERA';const record={inscripcion_id:'INS-'+crypto.randomUUID(),usuario_id:user.usuario_id,evento_id:event.evento_id,estado:state,fecha_inscripcion:now.toISOString(),fecha_actualizacion:now.toISOString(),nombre_acreditacion:String(body.nombre_acreditacion||user.nombre).trim().slice(0,100),observaciones:String(body.observaciones||'').trim().slice(0,500),origen:'WEB',orden_espera:state==='LISTA_ESPERA'?Math.max(0,...rows.filter(r=>r.evento_id===event.evento_id&&r.estado==='LISTA_ESPERA').map(r=>Number(r.orden_espera)||0))+1:''};out={write:true,notify:true,status:201,...record,response:{ok:true,data:{inscripcion:publicRow(record),idempotente:false},error:null},audit:{auditoria_id:'AUD-'+crypto.randomUUID(),inscripcion_id:record.inscripcion_id,usuario_id:user.usuario_id,evento_id:event.evento_id,accion:'CREATE',estado_anterior:'',estado_nuevo:state,fecha:now.toISOString(),resultado:'OK',detalle:'Inscripción creada con cálculo dinámico de cupos.'},notificationPayload:{usuario_id:user.usuario_id,tipo:state==='CONFIRMADA'?'INSCRIPCION_CONFIRMADA':'LISTA_ESPERA',titulo:state==='CONFIRMADA'?'Inscripción confirmada':'Estás en lista de espera',mensaje:state==='CONFIRMADA'?'Tu cupo fue confirmado para '+event.nombre+'.':'Te avisaremos cuando se libere un cupo para '+event.nombre+'.',evento_id:event.evento_id,inscripcion_id:record.inscripcion_id,clave_idempotencia:'ENROLL-'+record.inscripcion_id+'-'+state}};}}}\n} else {const current=rows.find(r=>r.inscripcion_id===String(body.inscripcion_id||'')&&r.usuario_id===user.usuario_id);if(!current)out=fail(404,'INSCRIPCION_NO_EXISTE','No se encontró la inscripción.');else if(op==='CANCEL'){if(current.estado==='CANCELADA')out={write:false,notify:false,status:200,response:{ok:true,data:{inscripcion:publicRow(current),idempotente:true},error:null}};else {const record={...current,estado:'CANCELADA',fecha_actualizacion:now.toISOString()};const event=events.find(e=>e.evento_id===record.evento_id);out={write:true,notify:true,status:200,...record,response:{ok:true,data:{inscripcion:publicRow(record)},error:null},audit:{auditoria_id:'AUD-'+crypto.randomUUID(),inscripcion_id:record.inscripcion_id,usuario_id:user.usuario_id,evento_id:record.evento_id,accion:'CANCEL',estado_anterior:current.estado,estado_nuevo:'CANCELADA',fecha:now.toISOString(),resultado:'OK',detalle:'Cancelación lógica solicitada por el usuario.'},notificationPayload:{usuario_id:user.usuario_id,tipo:'INSCRIPCION_CANCELADA',titulo:'Inscripción cancelada',mensaje:'Tu inscripción'+(event?' para '+event.nombre:'')+' fue cancelada.',evento_id:record.evento_id,inscripcion_id:record.inscripcion_id,clave_idempotencia:'CANCEL-'+record.inscripcion_id}};}} else {const record={...current,nombre_acreditacion:body.nombre_acreditacion===undefined?current.nombre_acreditacion:String(body.nombre_acreditacion).slice(0,100),observaciones:body.observaciones===undefined?current.observaciones:String(body.observaciones).slice(0,500),fecha_actualizacion:now.toISOString()};out={write:true,notify:false,status:200,...record,response:{ok:true,data:{inscripcion:publicRow(record)},error:null},audit:{auditoria_id:'AUD-'+crypto.randomUUID(),inscripcion_id:record.inscripcion_id,usuario_id:user.usuario_id,evento_id:record.evento_id,accion:'UPDATE',estado_anterior:current.estado,estado_nuevo:current.estado,fecha:now.toISOString(),resultado:'OK',detalle:'Datos permitidos de inscripción actualizados.'}};}}\nreturn [{json:out}];"
      },
