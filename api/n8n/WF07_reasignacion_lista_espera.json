    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const now=new Date();const events=$('Leer Eventos').all().map(i=>i.json).filter(x=>x.evento_id);const enrollments=$('Leer Inscripciones').all().map(i=>i.json).filter(x=>x.inscripcion_id);const users=$('Leer Usuarios').all().map(i=>i.json).filter(x=>x.usuario_id);const links=$input.all().map(i=>i.json).filter(x=>x.vinculacion_id);const starts=e=>Date.parse(String(e.fecha||'')+'T'+String(e.hora||'00:00')+'-05:00');const output=[];for(const event of events.filter(e=>e.estado==='PUBLICADO'&&starts(e)>+now)){let seats=Math.max(0,Number(event.capacidad||0)-enrollments.filter(r=>r.evento_id===event.evento_id&&r.estado==='CONFIRMADA').length);const waiting=enrollments.filter(r=>r.evento_id===event.evento_id&&r.estado==='LISTA_ESPERA').sort((a,b)=>Date.parse(a.fecha_inscripcion)-Date.parse(b.fecha_inscripcion)||String(a.inscripcion_id).localeCompare(String(b.inscripcion_id)));for(const current of waiting){if(!seats)break;if(!users.some(u=>u.usuario_id===current.usuario_id&&u.estado==='ACTIVO')||!links.some(l=>l.usuario_id===current.usuario_id&&l.estado==='ACTIVA'))continue;const record={...current,estado:'CONFIRMADA',fecha_actualizacion:now.toISOString()};output.push({write:true,...record,reasignacion_id:'REA-'+crypto.randomUUID(),fecha:now.toISOString(),orden_lista:current.orden_espera||'',estado_anterior:'LISTA_ESPERA',estado_nuevo:'CONFIRMADA',resultado_notificacion:'PENDIENTE',usuario_id:current.usuario_id,notificationPayload:{usuario_id:current.usuario_id,tipo:'REASIGNACION_CUPO',titulo:'Cupo reasignado',mensaje:'Se liberó un cupo para '+event.nombre+'. Tu inscripción fue confirmada.',evento_id:event.evento_id,inscripcion_id:current.inscripcion_id,clave_idempotencia:'REALLOC-'+current.inscripcion_id}});seats--;}}return output;"
      },
