    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const now=new Date();const events=$('Leer Eventos').all().map(i=>i.json).filter(e=>e.evento_id);const enrollments=$('Leer Inscripciones').all().map(i=>i.json).filter(r=>r.inscripcion_id);const previous=$input.all().map(i=>i.json).filter(r=>r.recordatorio_id);const starts=e=>Date.parse(String(e.fecha||'')+'T'+String(e.hora||'00:00')+'-05:00');const out=[];for(const event of events.filter(e=>e.estado==='PUBLICADO')){const ms=starts(event)-+now;if(!Number.isFinite(ms)||ms<=0||ms>24*60*60*1000)continue;for(const enrollment of enrollments.filter(r=>r.evento_id===event.evento_id&&r.estado==='CONFIRMADA')){const key=enrollment.usuario_id+'|'+event.evento_id+'|24H';if(previous.some(r=>r.clave_idempotencia===key&&['PENDIENTE','ENVIADO'].includes(r.estado)))continue;out.push({recordatorio_id:'REM-'+crypto.randomUUID(),usuario_id:enrollment.usuario_id,evento_id:event.evento_id,inscripcion_id:enrollment.inscripcion_id,tipo_recordatorio:'24H',fecha_programada:now.toISOString(),fecha_envio:'',estado:'PENDIENTE',clave_idempotencia:key,titulo:'Recordatorio de evento',mensaje:'Tu evento '+event.nombre+' comienza en menos de 24 horas.'});}}return out;"
      },
