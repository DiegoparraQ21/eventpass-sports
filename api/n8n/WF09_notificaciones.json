    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const input=$('Cuando es ejecutado por otro workflow').first().json;const users=$('Leer Usuarios').all().map(i=>i.json).filter(u=>u.usuario_id);const links=$input.all().map(i=>i.json).filter(l=>l.vinculacion_id);const user=users.find(u=>u.usuario_id===input.usuario_id&&u.estado==='ACTIVO');if(!user)return[{json:{invalid:true,notificacion_id:'NOT-'+crypto.randomUUID(),usuario_id:input.usuario_id||'',tipo:input.tipo||'DESCONOCIDO',titulo:input.titulo||'',mensaje:input.mensaje||'',evento_id:input.evento_id||'',inscripcion_id:input.inscripcion_id||'',fecha:new Date().toISOString(),gmail_estado:'NO_APLICA',telegram_estado:'NO_APLICA',gmail_error:'Usuario no activo o inexistente.',telegram_error:'Usuario no activo o inexistente.',clave_idempotencia:input.clave_idempotencia||''}}];const link=links.find(l=>l.usuario_id===user.usuario_id&&l.estado==='ACTIVA');return[{json:{invalid:false,notificacion_id:'NOT-'+crypto.randomUUID(),usuario_id:user.usuario_id,tipo:String(input.tipo||'GENERAL'),titulo:String(input.titulo||'EventPass Sports'),mensaje:String(input.mensaje||''),evento_id:String(input.evento_id||''),inscripcion_id:String(input.inscripcion_id||''),fecha:new Date().toISOString(),email:user.email_normalizado,chat_id:link?String(link.chat_id):'',gmail_estado:'PENDIENTE',telegram_estado:link?'PENDIENTE':'NO_APLICA',gmail_error:'',telegram_error:link?'':'Sin vinculación activa de Telegram.',clave_idempotencia:String(input.clave_idempotencia||'NOT-'+crypto.randomUUID())}}];"
      },
