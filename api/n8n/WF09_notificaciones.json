        "subject": "=🏅 {{ $json.titulo }}",
        "message": "=<!doctype html>\n<html lang=\"es\">\n  <body style=\"margin:0;padding:0;background:#eef3f7;font-family:Arial,Helvetica,sans-serif;color:#08243a;\">\n    <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#eef3f7;padding:32px 16px;\">\n      <tr>\n        <td align=\"center\">\n          <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:620px;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 10px 28px rgba(8,36,58,0.14);\">\n            \n            <tr>\n              <td style=\"background:#082b45;padding:28px 34px;\">\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                  <tr>\n                    <td style=\"color:#ffffff;font-size:22px;font-weight:700;\">\n                      <span style=\"display:inline-block;background:#b7ff39;color:#082b45;width:34px;height:34px;line-height:34px;text-align:center;border-radius:10px;font-family:Georgia,serif;font-style:italic;margin-right:10px;\">E</span>\n                      EventPass<span style=\"color:#b7ff39;\">Sports</span>\n                    </td>\n                    <td align=\"right\" style=\"color:#b7ff39;font-size:12px;font-weight:700;letter-spacing:1px;\">\n                      EVENTOS DEPORTIVOS\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <tr>\n              <td style=\"padding:38px 34px 26px;\">\n                <div style=\"width:52px;height:52px;line-height:52px;text-align:center;background:#e9ffd0;border-radius:50%;font-size:27px;margin-bottom:18px;\">\n                  ✓\n                </div>\n\n                <p style=\"margin:0 0 8px;color:#6a7b89;font-size:12px;font-weight:700;letter-spacing:1.2px;\">\n                  NOTIFICACIÓN EVENTPASS\n                </p>\n\n                <h1 style=\"margin:0 0 16px;font-size:28px;line-height:34px;color:#082b45;\">\n                  {{ $json.titulo }}\n                </h1>\n\n                <p style=\"margin:0 0 24px;font-size:16px;line-height:25px;color:#40576a;\">\n                  {{ $json.mensaje }}\n                </p>\n\n                <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background:#f3f7fa;border-radius:14px;margin:0 0 28px;\">\n                  <tr>\n                    <td style=\"padding:18px 20px;\">\n                      <p style=\"margin:0 0 8px;font-size:12px;color:#71808d;font-weight:700;letter-spacing:0.8px;\">DETALLES DE TU PASE</p>\n                      <p style=\"margin:0 0 5px;font-size:14px;color:#082b45;\"><strong>Evento:</strong> {{ $json.evento_id }}</p>\n                      <p style=\"margin:0;font-size:14px;color:#082b45;\"><strong>Referencia:</strong> {{ $json.inscripcion_id }}</p>\n                    </td>\n                  </tr>\n                </table>\n\n                <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\n                  <tr>\n                    <td style=\"background:#b7ff39;border-radius:10px;\">\n                      <a href=\"https://eventpass-sports.vercel.app/\" style=\"display:inline-block;padding:14px 22px;color:#082b45;text-decoration:none;font-size:14px;font-weight:700;\">\n                        Consultar mis pases →\n                      </a>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <tr>\n              <td style=\"padding:20px 34px;background:#082b45;\">\n                <p style=\"margin:0;color:#b9c9d5;font-size:12px;line-height:18px;\">\n                  EventPass Sports · Vive el deporte. Haz que cuente.<br>\n                  Este es un mensaje automático; no respondas directamente a este correo.\n                </p>\n          