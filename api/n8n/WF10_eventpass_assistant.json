    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');const request=$('Preparar consulta de soporte').first().json;if(request.invalid)return[{json:request}];const conversations=$input.all().map(i=>i.json).filter(r=>r.conversation_id);const events=$('Leer Eventos para soporte').all().map(i=>i.json).filter(r=>r.evento_id&&r.estado==='PUBLICADO');const now=new Date().toISOString();const current=conversations.find(c=>c.conversation_id===request.conversation_id);const conversation={conversation_id:request.conversation_id,usuario_id:request.usuario_id,visitor_id:request.visitor_id,fecha_inicio:current?.fecha_inicio||now,fecha_ultima_interaccion:now,estado:'ABIERTA'};const eventContext=events.map(e=>e.evento_id+' | '+e.nombre+' | '+e.categoria+' | '+e.fecha+' '+e.hora+' | '+e.lugar+' | capacidad '+e.capacidad).join('\\n');const prompt='Pregunta del visitante: '+request.chatInput+'\\n\\nEventos publicables disponibles:\\n'+eventContext;return[{json:{...request,...conversation,saveConversation:true,userMessage:{message_id:'MSG-'+crypto.randomUUID(),conversation_id:request.conversation_id,usuario_id:request.usuario_id,visitor_id:request.visitor_id,rol:'USER',mensaje:request.chatInput,timestamp:now},prompt}}];"
