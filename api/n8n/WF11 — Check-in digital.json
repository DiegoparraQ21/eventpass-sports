    {
      "parameters": {
        "jsCode": "const entrada = $('Normalizar entrada').first().json;\nconst inscripciones = $('Leer inscripción').all().map((item) => item.json).filter((row) => row.inscripcion_id);\nconst eventos = $('Leer evento').all().map((item) => item.json).filter((row) => row.evento_id);\nconst historial = $('Leer historial de check-in').all().map((item) => item.json).filter((row) => row.inscripcion_id);\n\nconst inscripcion = inscripciones.find(\n  (row) => String(row.inscripcion_id) === entrada.inscripcion_id,\n);\n\nconst evento = eventos.find(\n  (row) => String(row.evento_id) === entrada.evento_id,\n);\n\nconst checkinExitoso = historial.find(\n  (row) =>\n    String(row.inscripcion_id) === entrada.inscripcion_id &&\n    String(row.resultado).toUpperCase() === 'EXITOSO',\n);\n\nlet resultado = 'EXITOSO';\nlet detalle = 'Check-in realizado correctamente.';\nlet accion = 'REGISTRAR';\n\nif (!entrada.inscripcion_id || !entrada.evento_id) {\n  resultado = 'RECHAZADO';\n  detalle = 'La solicitud debe incluir inscripcion_id y evento_id.';\n  accion = 'REGISTRAR_INTENTO';\n} else if (!inscripcion) {\n  resultado = 'RECHAZADO';\n  detalle = 'La inscripción no existe.';\n  accion = 'REGISTRAR_INTENTO';\n} else if (!evento) {\n  resultado = 'RECHAZADO';\n  detalle = 'El evento no existe.';\n  accion = 'REGISTRAR_INTENTO';\n} else if (String(inscripcion.evento_id) !== entrada.evento_id) {\n  resultado = 'RECHAZADO';\n  detalle = 'La inscripción no pertenece al evento enviado.';\n  accion = 'REGISTRAR_INTENTO';\n} else if (checkinExitoso) {\n  resultado = 'DUPLICADO';\n  detalle = 'El ingreso ya había sido registrado.';\n  accion = 'REGISTRAR_INTENTO';\n} else if (String(inscripcion.estado).toUpperCase() !== 'CONFIRMADA') {\n  resultado = 'RECHAZADO';\n  detalle = `La inscripción se encuentra en estado ${inscripcion.estado || 'DESCONOCIDO'} y no permite asistencia.`;\n  accion = 'REGISTRAR_INTENTO';\n}\n\nreturn [{\n  json: {\n    ...entrada,\n    usuario_id: inscripcion?.usuario_id || '',\n    resultado,\n    detalle,\n    accion,\n    fecha_checkin: new Date().toISOString(),\n  },\n}];"
      },
